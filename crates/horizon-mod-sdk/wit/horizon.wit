/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.0;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    /// One line in the game's log as `[mod <id>] message`, at that level.
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player, the world clock and the block
/// the player looks at.
interface game {
    record player {
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
        /// 0 to 20, as the hunger bar.
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    /// None on the title screen.
    get-clock: func() -> option<clock>;
    /// A block along the player's view.
    record hit {
        /// The block hit.
        block-x: s32,
        block-y: s32,
        block-z: s32,
        /// The point on its face where the view meets it.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:stone`, ...
        block: string,
    }
    /// The first block along the player's view (fluids pass), up to
    /// `distance` blocks (at most 1024; past the loaded chunks, across the
    /// distant terrain when LOD Distance is on), as of this tick. None when
    /// nothing is hit, and on the title screen.
    raycast: func(distance: f32) -> option<hit>;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        /// Plain text, up to 256 characters.
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    /// Replaces the mod's panel: up to 16 lines in that corner of the screen.
    set-panel: func(corner: corner, lines: list<line>);
    /// Removes the mod's panel.
    clear: func();
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
}

/// Capability `command`: vanilla commands run as the player, with the
/// player's permissions, after the hook call returns (8 per call). A mod's
/// own commands are not run this way.
interface command {
    /// `line` without its slash; its feedback goes to the chat as if typed.
    run: func(line: string);
    /// `lines` (each without its slash, at most 256 a call) as `run` does,
    /// but with nothing in the chat: no feedback and no failure. In single
    /// player and on Horizon's servers, each runs exactly as the player
    /// typing it would (the same rights), in order, 64 a tick, and the
    /// server logs one line a batch; one that carries a chat message (`say`,
    /// `msg`) is refused. On any other server they go as chat commands, and
    /// there their feedback shows: a mod running many should say so.
    run-quiet: func(lines: list<string>);
}

/// Capability `ui`: widgets the game draws with its own menus' widgets, for
/// a screen the mod owns and a settings page in Options > Mods. Layout and
/// drawing are the game's: a mod says what its widgets hold, never where
/// they sit or how they look, and the game clips everything it is handed.
interface ui {
    /// A line of text.
    record text-widget {
        /// The mod's own name for the widget; `ui-events` calls echo it.
        id: u32,
        /// Up to 256 characters.
        text: string,
        /// 0xRRGGBB; 0 is the menus' white.
        color: u32,
    }
    /// An item's icon and a name beside it, as recipe viewers show them.
    record item-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown id draws a "?".
        item: string,
        /// The name shown beside the icon (empty: the item's own).
        name: string,
    }
    /// Rows the player picks one of, as an options page lists choices: a
    /// pick is `ui-events::select`, `selected` is the row to mark now.
    record list-widget {
        /// The mod's own name for the widget; `ui-events::select` echoes it.
        id: u32,
        /// The rows' texts, at most 512, each up to 256 characters.
        rows: list<string>,
        /// The row to mark as the current choice, if any.
        selected: option<u32>,
    }
    /// A thing on a mod's screen or settings page.
    /// A button as the options pages have them (200 × 20): a click is
    /// `ui-events::select(id, 0)`. Mods cycle its label for a choice
    /// ("Corner: Top Left").
    record button-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// Up to 256 characters.
        label: string,
    }
    variant widget {
        /// Text the player reads.
        text(text-widget),
        /// A button.
        button(button-widget),
        /// An item's icon and name.
        item(item-widget),
        /// Rows the player picks from.
        %list(list-widget),
    }
    /// A screen the mod owns: a title over widgets stacked down the middle,
    /// the Done button the game adds, and Esc to leave it.
    record screen {
        /// Its title, up to 256 characters.
        title: string,
        /// Its widgets, in order, at most 64.
        widgets: list<widget>,
    }
    /// Show `screen` over the game; a second call while it is open replaces
    /// it. Only the last call of one hook counts.
    open-screen: func(screen: screen);
    /// Close the mod's screen when it is open (the mod hears no `closed`
    /// for this: it was its own doing).
    close-screen: func();
    /// The mod's page in Options > Mods, reached from a settings button on
    /// its row: the widgets it shows, an empty list for no page. The player
    /// opening the page is `ui-events::settings-opened`: push fresh widgets
    /// then; later calls update the page while it shows.
    set-settings: func(widgets: list<widget>);
}

/// What the game calls on a mod that shows widgets (capability `ui`):
/// what the player did with them.
interface ui-events {
    /// A row of one of the mod's `list` widgets was picked: the widget's
    /// `id` and the row, on the screen or the settings page that showed it.
    select: func(id: u32, row: u32);
    /// The player left the mod's screen (Esc or Done); not for a screen the
    /// mod closed itself or one that went away with the mod.
    closed: func();
    /// The player opened the mod's settings page in Options > Mods: call
    /// `ui::set-settings` now to fill it with fresh widgets.
    settings-opened: func();
}

/// Capability `input` (experimental: the manifest needs
/// `experimental = ["input"]`): the use button on items the mod claims, and
/// the mod's own keys. Events wait for `poll`, at most 256.
interface input {
    /// The main hand's stack.
    record held-item {
        /// `minecraft:spyglass`, `<mod>:<path>`.
        id: string,
        count: u32,
        /// The hotbar slot, 0 to 8.
        slot: u32,
    }
    record item-use {
        item: held-item,
        /// Game ticks the button was held (0 on `use-start`).
        ticks: u32,
    }
    variant event {
        /// The use button went down with a claimed item in the main hand.
        /// The game does nothing else with the click: no placing, no eating,
        /// no swing.
        use-start(item-use),
        /// It came up again, or the item left the hand, or a screen opened.
        use-stop(item-use),
        /// A key `register-key` named went down or up while playing (no
        /// screen open). The game's own mapping on that key still runs. A
        /// screen opening lets every held key up.
        key-down(string),
        key-up(string),
        /// Mouse wheel steps while the mod holds the wheel (`claim-wheel`):
        /// positive away from the player, as the hotbar reads them.
        wheel(f32),
    }
    /// The items whose use the mod handles instead of the game, by id (at
    /// most 64). Replaces the previous list.
    claim-items: func(ids: list<string>);
    /// A key of the mod's: `name` comes back in `key-down` and `key-up`,
    /// `label` says what it does, `key` is the key as options.txt writes
    /// it (`key.keyboard.r`), the default: the player can bind another
    /// one on the mod's page in Options > Mods, and that one wins. At most
    /// 16; an unknown key is an error.
    register-key: func(name: string, label: string, key: string) -> result<_, string>;
    /// The main hand's stack, as of this tick; none when it is empty.
    held: func() -> option<held-item>;
    /// The events since the last call, oldest first.
    poll: func() -> list<event>;
    /// Takes the mouse wheel while playing (true) or gives it back: while
    /// taken, its steps are the mod's `wheel` events and the hotbar doesn't
    /// move. The game gives it back when the mod stops.
    claim-wheel: func(on: bool);
    /// A mapping as the player has bound it.
    record mapping-state {
        /// The bound key's name as Controls shows it: `W`, `Space`, `LMB`.
        label: string,
        /// Held down now (as of this frame for a mod with a `frame` hook,
        /// else this tick).
        down: bool,
    }
    /// A movement or click mapping as the player has bound it: `key.forward`,
    /// `key.left`, `key.back`, `key.right`, `key.jump`, `key.sneak`,
    /// `key.sprint`, `key.attack` or `key.use`. None for another name.
    mapping: func(name: string) -> option<mapping-state>;
    /// Clicks of the attack and use buttons in the last second.
    clicks-per-second: func() -> tuple<u32, u32>;
}

/// Capability `render` (experimental: the manifest needs
/// `experimental = ["render"]`): shapes the game draws for the mod with its
/// own renderer, kept until the mod replaces them (no call per frame). A mod
/// never supplies shader code.
interface render {
    /// A corner of the screen, as `hud`'s panels use them.
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    /// A rectangle in GUI pixels: the top left corner and the size.
    record rect {
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }
    /// A point in GUI pixels from the screen's top left.
    record point {
        x: f32,
        y: f32,
    }
    record fill-shape {
        rect: rect,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// Any four-cornered shape (a wheel's segment, an arrow): the corners
    /// in order round it.
    record quad-shape {
        corners: tuple<point, point, point, point>,
        /// 0xAARRGGBB.
        color: u32,
    }
    record sprite-shape {
        /// One of the game's GUI sprites, as `gui/sprites/` names them
        /// (`hud/heart/full`, `widget/button`), the resource packs' versions
        /// included. An unknown one draws nothing.
        sprite: string,
        rect: rect,
        /// A tint, 0xAARRGGBB: 0xFFFFFFFF draws it as it is.
        color: u32,
    }
    record item-shape {
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown one draws nothing.
        item: string,
        /// The icon's top left.
        at: point,
        /// 1.0 is the hotbar's 16 × 16.
        scale: f32,
    }
    record text-shape {
        /// Up to 256 characters, one line.
        text: string,
        at: point,
        /// 0xRRGGBB, as `hud`'s lines.
        color: u32,
        /// Centred on `at.x` instead of starting there.
        centered: bool,
        shadow: bool,
    }
    variant shape {
        fill(fill-shape),
        quad(quad-shape),
        sprite(sprite-shape),
        item(item-shape),
        text(text-shape),
    }
    /// Replaces the mod's HUD shapes: up to 1024, drawn every frame in
    /// order over the HUD (after the hotbar, under chat and screens), hidden
    /// with the HUD (F1). An empty list removes them.
    set-hud: func(shapes: list<shape>);
    /// The screen's size in GUI pixels (width, height), as of this tick.
    gui-size: func() -> tuple<f32, f32>;
    /// Shakes the camera: a jolt of `strength` (0 to 1, 1 the hardest) that
    /// fades out over `seconds` (at most 10). Jolts add up to 1. The view
    /// turns, the player doesn't, and the player's Distortion Effects option
    /// scales it (0 turns it off).
    shake: func(strength: f32, seconds: f32);
    /// Replaces the mod's corner panel: shapes in GUI pixels from the top
    /// left of a `width` × `height` box that the game places in `corner`,
    /// stacked with the game's overlays and the other mods' panels (under
    /// the status effects at the top right), as `hud`'s panels are.
    set-corner: func(corner: corner, width: f32, height: f32, shapes: list<shape>);
    /// Removes the mod's corner panel.
    clear-corner: func();
    /// The width of one line of text in GUI pixels, in the HUD's font: exact
    /// for Latin letters (U+0000 to U+024F), 6 per other character.
    text-width: func(text: string) -> f32;
    record frame-rate {
        /// Frames drawn in the last second.
        fps: u32,
        /// The slowest frame's rate, and the 1% low (the 99th percentile
        /// frame time's rate), over the last 5 seconds.
        min: u32,
        low: u32,
    }
    /// The game's frame counter, recomputed twice a second.
    frame-stats: func() -> frame-rate;
    record zoom {
        /// The field of view is divided by it: 1 is none, at most 10.
        factor: f32,
        /// Ease in and out through the game's field-of-view easing, as the
        /// spyglass does, instead of at once.
        smooth: bool,
        /// Mouse turning is multiplied by it while zoomed: 1 keeps the
        /// player's sensitivity, at least 0.05.
        turn: f32,
    }
    /// Zooms the camera until the next call (`factor` 1 ends it), only
    /// while playing: a screen opening or the spyglass's own view (which
    /// wins) leave the camera vanilla's. With several mods, the strongest
    /// zoom counts.
    set-zoom: func(zoom: zoom);
    record minimap {
        corner: corner,
        /// Its side in GUI pixels, 16 to 256.
        size: f32,
        /// World blocks per map pixel, 0.5 to 4; the map is 128 × 128 pixels.
        blocks-per-pixel: f32,
        /// The map turns with the player, who faces up, and an N on its rim
        /// marks north. Otherwise north is up and the player's arrow turns.
        rotate: bool,
        /// Round, the corners left clear; otherwise square.
        round: bool,
    }
    /// Shows a map of the world around the player in `corner`, stacked with
    /// the game's overlays and the mods' panels, until the next call (none
    /// hides it). It looks like a map item: vanilla's map colours with their
    /// height shading and water depth, and the player's arrow. Underground,
    /// under a roof and in the Nether it maps the floor around the player's
    /// height. The game keeps the map's tiles and refreshes them within its
    /// own frame budget; hidden, they are dropped. One map shows at a time:
    /// the first loaded mod's.
    set-minimap: func(minimap: option<minimap>);
    record far-terrain {
        /// How far the distant terrain reaches, in chunks: 64 to 1024. On
        /// integrated graphics other than Apple's the game caps it lower.
        distance: u32,
        /// Coarser far tiles, as the Far Detail setting's Reduced: 2 to 4 ms
        /// less GPU time per frame on integrated graphics.
        reduced: bool,
    }
    /// Draws the world beyond the render distance as distant terrain, out to
    /// `distance` chunks, until the next call (none ends it). The game builds
    /// it on its own workers, from the chunks already loaded or saved and,
    /// where nobody has been, from the world's generator; the simulation
    /// distance doesn't change. Only worlds whose generator the game has
    /// (single player and a LAN world you host) show it. The player's own LOD
    /// Distance setting, when on, wins. One far terrain shows at a time: the
    /// first loaded mod's.
    set-far-terrain: func(far-terrain: option<far-terrain>);
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    /// Each game tick while in a world, with the game's tick counter.
    tick: func(tick: u64);
    /// Each rendered frame, with the seconds since the last one.
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    /// Each chat line the player receives, as plain text.
    chat: func(text: string);
}

/// Capability `recipes` (experimental): the recipes and items the game
/// knows, for recipe viewers. In single player and on Horizon's servers
/// they are the world's; on any other server they are vanilla 26.3's (a
/// client is sent no others), while `known` follows that server's book.
interface recipes {
    /// An item of `items`, by its index there, with a count and the
    /// components it has beyond the item's own, in vanilla's item syntax
    /// (`[potion_contents={potion:"minecraft:swiftness"}]`), or "".
    record stack {
        item: u32,
        count: u32,
        components: string,
    }
    /// The station a recipe is made at.
    enum kind {
        crafting-shaped,
        crafting-shapeless,
        smelting,
        blasting,
        smoking,
        campfire,
        stonecutting,
        smithing,
        brewing,
    }
    record recipe {
        /// `minecraft:oak_planks`.
        id: string,
        kind: kind,
        /// The recipe book's tab (`crafting_building_blocks`,
        /// `furnace_food`), or "".
        category: string,
        /// Recipes the book shows on one button share a group, or "".
        group: string,
        /// A shaped recipe's grid: `slots` holds its cells row by row.
        /// 0 for the other kinds.
        width: u32,
        height: u32,
        /// Each slot's stacks, any one of which fits; an empty list is an
        /// empty cell. Cooking and stonecutting: the input. Smithing: the
        /// template, the base, the addition. Brewing: the bottle, the
        /// reagent.
        slots: list<list<stack>>,
        /// What it makes; several when that varies (a trim on any armour).
        results: list<stack>,
        /// Cooking: game ticks and experience; 0 for the other kinds.
        cooking-time: u32,
        experience: f32,
        /// The recipe book's id for it (one per way the book shows it), as
        /// `known` lists them; -1 for the kinds the book doesn't show
        /// (campfire, stonecutting, smithing, brewing).
        book-id: s32,
    }
    record item {
        /// `minecraft:diamond`, `<mod>:<path>`.
        id: string,
        /// In the player's language.
        name: string,
        /// Its item tags, without the `#`.
        tags: list<string>,
    }
    /// Every item, in the registry's order: `stack.item` indexes this list.
    items: func() -> list<item>;
    /// Every recipe: the book's in its order, then campfire, stonecutting,
    /// smithing and brewing. They don't change while a world is open.
    all: func() -> list<recipe>;
    /// The `book-id`s of the recipes the player's recipe book holds now.
    known: func() -> list<s32>;
    /// Places a recipe in the open screen's grid as a click in the recipe
    /// book does (`ServerboundPlaceRecipePacket`): the inventory's grid or
    /// a crafting table. `all` places as many as the items allow, as with
    /// Shift. Refused while no such screen is open, for a recipe the
    /// player's book doesn't hold and for one that can't be placed; one
    /// missing items shows as a ghost in the grid, as in the book.
    place: func(book-id: s32, all: bool) -> result<_, string>;
    /// Creative mode only: gives the player the stack, as taking it from
    /// the creative inventory does (`ServerboundSetCreativeModeSlot`): the
    /// selected slot first, then the hotbar, then the inventory. The count
    /// is cut to one stack of the item (64, 16 or 1).
    give: func(stack: stack) -> result<_, string>;
}

/// Capability `ui` (experimental): a recipe viewer's panel beside the
/// game's inventory and container screens (not the creative inventory), on
/// the right of the screen. The game draws it with its own widgets and
/// slots, pages it and keeps its search box; the mod says what it holds.
/// The first loaded mod with a panel shows.
interface browser {
    /// An item to show: its id, a count (1 draws none) and its components
    /// beyond the item's own, in vanilla's item syntax, or "".
    record stack {
        item: string,
        count: u32,
        components: string,
    }
    /// A click on an item of the panel, by its index in `set-items`'s list.
    record click {
        index: u32,
        right: bool,
    }
    /// A key the mod registered (`input.register-key`) went down while the
    /// pointer was on an item: a slot of the screen's, or the panel's.
    record item-key {
        key: string,
        stack: stack,
    }
    /// A click on a slot of a recipe the panel shows (`set-recipes`).
    record slot-click {
        /// The recipe's index in `set-recipes`'s list and the slot's in
        /// it; the results come after the slots.
        recipe: u32,
        slot: u32,
        /// The stack the slot showed at that moment.
        stack: stack,
        right: bool,
    }
    variant event {
        clicked(click),
        /// The search box's text, each time the player changes it.
        search(string),
        key(item-key),
        slot-clicked(slot-click),
        /// The action button of the recipe at this index in
        /// `set-recipes`'s list.
        action(u32),
        /// The player turned the recipes' page (`set-recipes`): the index
        /// of the first recipe now shown.
        page(u32),
        /// The back button of `set-recipes`.
        back,
        /// The player picked the tab at this index of `set-recipes`' tabs.
        tab(u32),
    }
    /// How the game lays out a recipe of `set-recipes`.
    enum layout {
        /// A crafting grid of `width` x `height` slots, an arrow and the
        /// result.
        grid,
        /// One input over a flame, an arrow and the result (furnaces,
        /// smokers, campfires).
        cooking,
        /// One input, an arrow and the result (the stonecutter).
        single,
        /// Template, base and addition, an arrow and the result.
        smithing,
        /// A potion and an ingredient, an arrow and the result.
        brewing,
    }
    /// A recipe to show. Each slot, and the result, cycles through its
    /// stacks, one a second; an empty slot shows nothing.
    record recipe-view {
        layout: layout,
        /// The grid's size (`grid` only), at most 3 x 3.
        width: u32,
        height: u32,
        slots: list<list<stack>>,
        results: list<stack>,
        /// A short line under the recipe (a cooking time), or "".
        note: string,
        /// The action button beside it: none, enabled, or shown greyed.
        action: option<bool>,
    }
    /// The panel's items, at most 8192 (an empty list hides the panel).
    set-items: func(items: list<stack>);
    /// Shows these recipes in the panel instead of its items, as many as
    /// fit a page, under `title` and a back button, with a row of `tabs`
    /// (each an icon; `tab` is the selected one) between them; an empty
    /// list of recipes shows the items again. At most 256 recipes and 16
    /// tabs.
    set-recipes: func(title: string, tabs: list<stack>, tab: u32, recipes: list<recipe-view>);
    /// What the player did on the panel since the last poll, at most 256
    /// kept.
    poll: func() -> list<event>;
}

/// Capability `players`, server mods only (manifest `api = "0.3"`,
/// experimental): the players on the server, and messages to them.
interface players {
    enum game-mode {
        survival,
        creative,
        adventure,
        spectator,
    }
    record player {
        /// The player's UUID, `xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx`.
        id: string,
        name: string,
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
        game-mode: game-mode,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
    }
    /// The players online, in the order they joined.
    online: func() -> list<player>;
    /// A system message to one player, after the mod's name; false when no
    /// player with that id is online. Up to 8 messages per call.
    tell: func(player: string, text: string) -> bool;
    /// A system message to every player and the server's log, after the
    /// mod's name. Counts toward the same 8 per call.
    broadcast: func(text: string);
    /// Adds a velocity, in blocks per tick, to a player after the call (a
    /// conveyor, a fan): false when no player with that id is online. Each
    /// component is clamped to -4 to 4. At most 256 pushes a call.
    push: func(player: string, x: f64, y: f64, z: f64) -> bool;
    record slot-stack {
        item: string,
        count: u32,
    }
    /// A player's inventory as of the start of this tick: 41 slots, 0 to 8
    /// the hotbar, 9 to 35 the rest, 36 to 39 the armor from feet to head,
    /// 40 the off hand (item components not shown); none when they are not
    /// online.
    inventory: func(player: string) -> option<list<option<slot-stack>>>;
    /// The hotbar slot (0 to 8) a player holds, as of the start of this tick.
    selected-slot: func(player: string) -> option<u32>;
}

/// Capability `world`, server mods only (manifest `api = "0.3"`,
/// experimental): the blocks of the server's loaded chunks, and changes to
/// them through the server's own block updates.
interface %world {
    record block-change {
        x: s32,
        y: s32,
        z: s32,
        /// `minecraft:oak_log[axis=y]`; properties left out take the block's
        /// defaults, `minecraft:stone` alone is the default state.
        state: string,
    }
    /// The block state at a position in a dimension (`minecraft:overworld`,
    /// ...), as `minecraft:oak_log[axis=y]`, as of this call: none where the
    /// server has no chunk loaded there.
    get-block: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// The biome at a position (`minecraft:plains`, ...), as the server
    /// stores it (one per 4 x 4 x 4 cell): none where no chunk is loaded.
    get-biome: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// Sets blocks as `/setblock` does: the old block entity removed,
    /// neighbours and shapes updated, light, and every player told. Every
    /// state is checked now (an error queues nothing); the changes are made
    /// in order after this call returns, before that dimension's next tick;
    /// one in a chunk not loaded then is skipped. At most 4096 per call.
    set-blocks: func(dimension: string, blocks: list<block-change>) -> result<_, string>;
    /// Uses an item on a block as a player would, after the call (a
    /// deployer): the block's own answer to it first (a lever pulled, a door
    /// opened, a note block tuned), and when it has none and the item is a
    /// block's, that block placed against `face` (0 down, 1 up, 2 north,
    /// 3 south, 4 west, 5 east) where there is air. Items' own uses (bone
    /// meal, flint and steel, buckets) are not run yet. At most 256 a call.
    use-item: func(dimension: string, x: s32, y: s32, z: s32, face: u8, item: string) -> result<_, string>;
    /// Breaks a block as a player holding `tool` (an item id; none for a
    /// bare hand) enchanted with `enchantments` (`minecraft:fortune`, 3 /
    /// `minecraft:silk_touch`, 1) would, after the call: its break particles
    /// and sound, a container's contents spilled, air in its place, and its
    /// loot table's drops when the tool is right for it (a pickaxe for
    /// stone). The drops go into the inventory at `into` (as `transfer` puts
    /// items in), what does not fit and all of them without one dropping
    /// where the block stood. A drill or a saw. At most 256 a call;
    /// unbreakable blocks (bedrock) are left.
    break-block: func(dimension: string, x: s32, y: s32, z: s32, tool: option<string>, enchantments: list<tuple<string, u32>>, into: option<tuple<s32, s32, s32>>) -> result<_, string>;

    /// One block of a scanned region, its state an index into the palette.
    record scanned-block {
        x: s32,
        y: s32,
        z: s32,
        state: u32,
    }
    /// The solid part of a region: every non-air block in loaded chunks, and
    /// the states they use once each.
    record region {
        palette: list<string>,
        blocks: list<scanned-block>,
    }
    /// Reads every block from (min-x, min-y, min-z) to (max-x, max-y, max-z),
    /// both ends included, as of this call; air and blocks in chunks not
    /// loaded are left out. At most 32768 positions in the box.
    scan: func(dimension: string, min-x: s32, min-y: s32, min-z: s32, max-x: s32, max-y: s32, max-z: s32) -> result<region, string>;
}

/// What the server calls in a server mod (manifest `api = "0.3"`,
/// experimental). Only the hooks `init` asks for are ever called. The player
/// in each event is as the server saw them when it happened.
interface server-events {
    use players.{player};

    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    /// What an argument of a command takes. The server sends each command
    /// and its arguments to players' games, whose chat box completes and
    /// colours them as vanilla's; the server parses them before the mod's
    /// `command` hook gets their values.
    variant argument-kind {
        /// One word: letters, digits and `_ - . +`.
        word,
        /// The rest of the line, spaces included: only last.
        text,
        /// A whole number, within the bounds given.
        integer(tuple<option<s32>, option<s32>>),
        /// A number with or without decimals.
        number,
        /// `true` or `false`.
        boolean,
        /// One online player: a name, or `@s` or `@p` (whoever typed it,
        /// as vanilla picks for a player).
        player,
        /// A block position: three whole numbers, each one also `~` or
        /// `~n`, relative to whoever typed it.
        block-pos,
    }
    record argument {
        /// Shown in the chat box's hint (`<height>`) and the key of its value.
        name: string,
        kind: argument-kind,
        /// Optional arguments come after every required one.
        optional: bool,
    }
    record server-command {
        /// Without the slash. A name vanilla already uses is refused
        /// (vanilla's command runs).
        name: string,
        /// In order; none: the command takes nothing after its name. Free
        /// text is one optional `text` argument.
        arguments: list<argument>,
    }
    /// An argument's value, parsed as its kind says.
    variant argument-value {
        word(string),
        text(string),
        integer(s32),
        number(f64),
        boolean(bool),
        player(player),
        block-pos(block-pos),
    }
    record registration {
        /// Commands players may type.
        commands: list<server-command>,
        /// Call `tick` every server tick (20 per second).
        tick: bool,
        /// Call `player-joined` and `player-left`.
        joins: bool,
        /// Call `chat` for each chat message a player sends.
        chat: bool,
        /// Call `block-broken` and `block-placed`.
        blocks: bool,
    }
    /// Once, after loading. An error keeps the mod off and is logged.
    init: func() -> result<registration, string>;
    /// Each server tick, with the server's tick counter.
    tick: func(tick: u64);
    /// A player joined the server; they are in `players.online` already.
    player-joined: func(player: player);
    /// A player left the server; they are no longer in `players.online`.
    player-left: func(player: player);
    /// A chat message a player sent, as plain text.
    chat: func(player: player, text: string);
    /// `/name args` typed by `player`: ok(some(text)) is their feedback,
    /// err(text) their error in red. `values` holds each argument given, by
    /// name, in order (an optional one left out isn't there); a line that
    /// doesn't parse never reaches the mod: the player gets vanilla's error.
    command: func(player: player, name: string, args: string, values: list<tuple<string, argument-value>>) -> result<option<string>, string>;
    /// A player broke the block at `pos` in their dimension: `state` is what
    /// was there, as `minecraft:oak_log[axis=y]`.
    block-broken: func(player: player, pos: block-pos, state: string);
    /// A player placed `state` at `pos` in their dimension.
    block-placed: func(player: player, pos: block-pos, state: string);
}

/// Capability `block-entities`, server mods only (manifest `api = "0.3"`,
/// experimental): bytes a mod keeps at block positions, for blocks it owns
/// (a gear's speed, a machine's progress). The game saves them with the
/// world's chunks and hands them back after a restart.
interface block-entities {
    /// The bytes last stored at a position, none when there are none.
    get: func(dimension: string, x: s32, y: s32, z: s32) -> option<list<u8>>;
    /// Stores bytes at a position (at most 64 KiB; 65,536 positions per
    /// mod), replacing any there. The game forgets them when the block is
    /// broken or replaced by something that is not one of the mod's.
    set: func(dimension: string, x: s32, y: s32, z: s32, data: list<u8>) -> result<_, string>;
    /// Forgets the bytes at a position.
    remove: func(dimension: string, x: s32, y: s32, z: s32);
    /// `set`, and the bytes also go to every player whose game has the
    /// chunk, now, whenever they change and when the chunk reaches a player
    /// later: what the mod's client half reads with `block-data` (NeoForge's
    /// update tag). A later `set` at the position keeps them on the server
    /// only; `remove` takes them from the players' games too. Saved with the
    /// world as `set`'s are.
    set-synced: func(dimension: string, x: s32, y: s32, z: s32, data: list<u8>) -> result<_, string>;
}

/// Capability `entities`, server mods (`experimental = ["entities"]`):
/// structures, blocks taken out of the grid as one object that moves and
/// turns as a whole, as Create's contraptions and Aeronautics' ships. Players'
/// games draw each as one model, between its poses of the last two ticks.
/// The game saves them with the world; one still there when the world
/// loads is put back into the grid where it stood, so no block is lost.
interface structures {
    record structure-block {
        /// Its place in the structure (0, 0, 0 is the structure's corner).
        x: s32,
        y: s32,
        z: s32,
        /// `minecraft:oak_planks`, `mymod:shaft[axis=x]`.
        state: string,
    }
    /// Where a structure is: the world position of its (0, 0, 0) corner,
    /// and its turn about that corner as a quaternion (x, y, z, w), made
    /// unit by the game.
    record pose {
        x: f64,
        y: f64,
        z: f64,
        rotation: tuple<f32, f32, f32, f32>,
    }
    /// Makes a structure of these blocks (at most 4096) at `pose` in a
    /// dimension, after the call: its id, the mod's own (at most 64 at
    /// once). The blocks are only drawn; taking them out of the world is
    /// `world.set-blocks`, as the SDK's `Structure::assemble` does.
    create: func(dimension: string, blocks: list<structure-block>, at: pose) -> result<u32, string>;
    /// Moves and turns one, after the call; players' games see it go
    /// there over the next tick. False for an id the mod does not hold.
    set-pose: func(id: u32, at: pose) -> bool;
    /// Takes one away, after the call (its blocks with it: putting them back
    /// is `world.set-blocks`).
    remove: func(id: u32) -> bool;
}

/// Capability `block-entities`, server mods: model parts drawn at the mod's
/// own blocks, each turning at a constant speed, as Flywheel's instances
/// draw Create's shafts and cogs. The server sends a position's parts to the
/// players whose games have its chunk once, and again only when they
/// change; their games turn them every frame. Saved with the world, and
/// gone when the block is broken.
interface visuals {
    record part {
        /// The block state whose model is drawn: `mymod:shaft[axis=x]`, a
        /// vanilla one too.
        state: string,
        /// The axis it turns about: 0 x, 1 y, 2 z.
        axis: u8,
        /// The point it turns about, in blocks from the position's corner
        /// (0.5, 0.5, 0.5 is the block's centre); at most 16 away.
        pivot: tuple<f32, f32, f32>,
        /// Where its model's corner is, in blocks from the position's
        /// corner: (0, 1, 0) draws it on top of the block.
        offset: tuple<f32, f32, f32>,
        /// Degrees a tick (360 at most), counterclockwise looking from the
        /// axis's positive end; negative turns the other way, 0 not at all.
        speed: f32,
        /// Its angle in degrees when set: parts set in one tick at the same
        /// speed turn together.
        angle: f32,
    }
    /// Draws `parts` (at most 16) at a block of the mod's own, replacing
    /// what it drew there, after the call; none draws nothing there any more.
    set: func(dimension: string, x: s32, y: s32, z: s32, parts: list<part>) -> result<_, string>;
    /// `set`, with each part's `angle` its angle at game time 0 instead of
    /// at the tick it was set: parts at one speed turn in step however far
    /// apart they were set, as Flywheel turns Create's cogs (angle = time x
    /// speed + offset), so their teeth mesh.
    set-in-phase: func(dimension: string, x: s32, y: s32, z: s32, parts: list<part>) -> result<_, string>;
}

/// Capability `net`, client mods: the bytes the mod's server half keeps
/// with `block-entities.set-synced`, at the blocks of the chunks the
/// player's game has, in the dimension the player is in, as of this tick.
interface block-data {
    record synced-block {
        x: s32,
        y: s32,
        z: s32,
        data: list<u8>,
    }
    /// The bytes at a position, none where the server sent none.
    get: func(x: s32, y: s32, z: s32) -> option<list<u8>>;
    /// Every position from (min-x, min-y, min-z) to (max-x, max-y, max-z),
    /// both ends included, holding bytes: at most 256, nearest the box's
    /// minimum corner first.
    in-box: func(min-x: s32, min-y: s32, min-z: s32, max-x: s32, max-y: s32, max-z: s32) -> list<synced-block>;
}

/// What the server calls in a mod's blocks, beside `server-events` (a mod
/// built without this export hears nothing of them).
interface block-events {
    record pos {
        x: s32,
        y: s32,
        z: s32,
    }
    /// The blocks (`mymod:gear`, ids without properties) whose instances
    /// the game ticks, asked once after `init`.
    ticking-blocks: func() -> list<string>;
    /// A position where the mod keeps data (`block-entities.set`) and a
    /// ticking block stands in a loaded chunk, once per server tick (at
    /// most 4096 positions per tick, the rest next tick), in `dimension`;
    /// `state` is the block's state as `minecraft:oak_log[axis=y]`. Data
    /// under any other block is forgotten.
    block-tick: func(dimension: string, pos: pos, state: string);
    /// The player with this id (`players.online`) used (right-clicked) a
    /// block of the mod's with an empty hand, in `dimension`; true when the
    /// mod handled it (the game then does nothing else).
    block-used: func(player: string, dimension: string, pos: pos, state: string) -> bool;
}

/// Capability `net`: messages between a mod's client half and its server
/// half, as custom payloads on the channel `horizon:mod/<mod id>`. A client
/// mod sends to the server it plays on; a server mod to one player or to all.
interface net {
    /// Sends up to 32 KiB. A client mod passes `none` (the server it plays
    /// on, which must run a mod with the same id). A server mod passes the
    /// id of a player (`players.online`), or `none` for every player.
    send: func(player: option<string>, data: list<u8>) -> result<_, string>;
}

/// What a client mod hears on its channel, beside its other exports (a mod
/// built without this export hears nothing).
interface net-events {
    /// A message from the mod's server half.
    message: func(data: list<u8>);
}

/// The same for a server mod (a separate interface: the SDK builds client
/// and server mods in one crate, whose exports can't share a name).
interface server-net-events {
    /// A message from the mod's client half on `player` (their id).
    message: func(player: string, data: list<u8>);
}

/// Capability `entities`, server mods only (manifest `api = "0.3"`,
/// experimental): small marker entities a mod places and moves, drawn as an
/// item (a mod's own item included) held where the entity stands. A first
/// step: no hitbox, no AI, no saving; a mod keeps what it needs in
/// `block-entities` or `storage` and places them again after a restart. They
/// exist in the dimension the world is simulating (the overworld at first).
interface entities {
    /// Places one at a position, facing `yaw` degrees, drawn as `item`
    /// (`mymod:gear`). Returns the mod's own handle for it (at most 1024 live
    /// at once).
    spawn: func(dimension: string, x: f64, y: f64, z: f64, yaw: f32, item: string) -> result<u32, string>;
    /// Moves one of the mod's entities; false for a handle it does not hold.
    move-to: func(handle: u32, x: f64, y: f64, z: f64, yaw: f32) -> bool;
    /// Changes the item an entity is drawn as.
    set-item: func(handle: u32, item: string) -> bool;
    /// Removes one of the mod's entities.
    remove: func(handle: u32) -> bool;
    /// Puts an item in an equipment slot of the entity (`mainhand`, `offhand`,
    /// `head`, `chest`, `legs`, `feet`); none empties it. A block's item on
    /// the head is drawn as the block, so a mod's own block (`mymod:gear`)
    /// can stand in the world as a model that `set-pose` then turns.
    set-slot: func(handle: u32, slot: string, item: option<string>) -> bool;
    /// Turns a body part of the entity, in degrees about x, y and z as an armor
    /// stand's `Pose` does: `head`, `body`, `left-arm`, `right-arm`,
    /// `left-leg` or `right-leg`. Values are wrapped to -360 to 360.
    set-pose: func(handle: u32, part: string, x: f32, y: f32, z: f32) -> bool;
    /// Places a block state (`mymod:gear[axis=x]`, a vanilla one too) as an
    /// entity: drawn full size like a falling block, with no gravity, never
    /// landing; the mod moves it with `move-to` (x and z are its centre, y
    /// its bottom) and takes it away with `remove`. Players do not collide
    /// with it. Counts toward the same 1024 entities. A moving structure is
    /// its blocks taken out of the world (`world.set-blocks`) and put back.
    spawn-block: func(dimension: string, x: f64, y: f64, z: f64, state: string) -> result<u32, string>;
    /// Turns an entity, in degrees: a block entity (`spawn-block`) about its
    /// centre, first `pitch` about x then `yaw` about y, so a block with
    /// `axis=x` spins about any axis (yaw 90 puts its x along z); a marker
    /// (`spawn`) by its yaw only. Sent to every client as the entity's
    /// rotation, a byte: angles go to the nearest 360/256 degrees, so a turn
    /// of a whole number of those a tick looks even.
    rotate: func(handle: u32, yaw: f32, pitch: f32) -> bool;
    /// Makes a block entity (`spawn-block`) solid for players, as a boat is:
    /// they stand on it and walk into it as on its full cube, and a player
    /// standing on it rides along as it moves; one it moves into from the
    /// side is not pushed. Sent to clients as the entity being silent.
    set-solid: func(handle: u32, solid: bool) -> bool;
}

/// Capability `containers`, server mods only (manifest `api = "0.3"`,
/// experimental): the mod's own blocks that hold items and open as a chest
/// (27 slots) for a player. The game keeps the items in the block's chest
/// entity, saved with the chunk.
interface containers {
    record item-stack {
        item: string,
        count: u32,
    }
    /// Makes a block of the mod's (`mymod:crate`, no properties) a
    /// container: the game gives its positions a chest's slots when opened
    /// or written. At most 64 blocks per mod.
    register: func(block: string) -> result<_, string>;
    /// `register` with a size: 27 slots opens as a chest, 9 as a dispenser's
    /// 3 x 3 and 5 as a hopper's row. A block registered twice keeps its first
    /// size.
    register-sized: func(block: string, slots: u32) -> result<_, string>;
    /// Opens the container at a position for the player with this id, after
    /// the call; false when the player is not online.
    open: func(player: string, dimension: string, x: s32, y: s32, z: s32) -> bool;
    /// The 27 slots of a container in a loaded chunk, as of the start of this
    /// tick; none where there is no container with items yet or none loaded.
    /// (Item components are not shown.)
    slots: func(dimension: string, x: s32, y: s32, z: s32) -> option<list<option<item-stack>>>;
    /// Puts a stack in slot 0 to 26 (none empties it), after the call, in a
    /// registered container; count 1 to 99. Components of what was there go.
    set-slot: func(dimension: string, x: s32, y: s32, z: s32, slot: u32, stack: option<item-stack>) -> result<_, string>;
    /// Names the container at a position (the title its window shows, saved
    /// with the chunk as a renamed chest's is); none clears it. After the
    /// call, in a registered container; at most 64 characters.
    set-name: func(dimension: string, x: s32, y: s32, z: s32, name: option<string>) -> result<_, string>;
    /// Limits what a player may put in one slot of a registered container, as
    /// vanilla's slots do (a furnace's fuel slot): `some(items)` allows only
    /// those item ids (`minecraft:coal`), an empty list nothing (an output or
    /// display slot players can only take from); none lifts the rule. Hoppers
    /// and the mod itself are not held to it. After the call; not saved, so the
    /// mod sets its rules again after a load.
    set-slot-rule: func(dimension: string, x: s32, y: s32, z: s32, slot: u32, allowed: option<list<string>>) -> result<_, string>;
}

/// Capability `redstone`, server mods only (manifest `api = "0.3"`,
/// experimental): the redstone signal reaching the mod's own blocks.
interface redstone {
    /// The strongest signal (0 to 15) reaching the block at a position from
    /// its neighbours (vanilla's best neighbour signal), as of the start of
    /// this tick. Known only for positions where the mod keeps block data
    /// (`block-entities.set`) or has a container, in the simulated
    /// dimension; none elsewhere.
    power: func(dimension: string, x: s32, y: s32, z: s32) -> option<u8>;
    /// Makes a block of the mod's give a redstone signal of 0 to 15 to its
    /// neighbours, after the call, until the mod sets another: the signal a
    /// trapped chest gives (analog, to every side). Only a block declared with
    /// the template `minecraft:trapped_chest` in `data/<id>/horizon/block/`
    /// gives one; any other block is left as it is. The signal is not saved:
    /// the mod sets it again when the world loads. At most 1024 a call.
    set-signal: func(dimension: string, x: s32, y: s32, z: s32, level: u8) -> result<_, string>;
}

/// Capability `items`, server mods only (manifest `api = "0.3"`,
/// experimental): items a mod's blocks put into the world.
interface items {
    /// Drops a stack as an item entity at a position (blocks, so
    /// x + 0.5 is a block's middle), after the call, in the dimension the
    /// world simulates; count 1 to 99. At most 64 drops a call. The item is
    /// any item id, a mod's own too.
    drop: func(dimension: string, x: f64, y: f64, z: f64, item: string, count: u32) -> result<_, string>;

    /// An item entity lying in the world.
    record dropped-item {
        /// The entity's id, for `take`; it lasts while the entity does.
        id: u32,
        item: string,
        count: u32,
        x: f64,
        y: f64,
        z: f64,
    }
    /// The item entities within `radius` blocks (at most 16) of a point, as
    /// of the start of this tick, nearest first, at most 256; only in the
    /// dimension the world is simulating.
    nearby: func(dimension: string, x: f64, y: f64, z: f64, radius: f32) -> list<dropped-item>;
    /// Removes an item entity (one `nearby` showed) after the call, to carry
    /// it into a machine; false when over the 256 takes a call.
    take: func(id: u32) -> bool;
    /// Adds a velocity, in blocks per tick, to an item entity (one `nearby`
    /// showed) after the call: a belt moving what lies on it. Clamped as
    /// `players.push` is; counts toward the same 256 a call as `take`.
    push: func(id: u32, x: f64, y: f64, z: f64) -> bool;
}

/// Capability `effects`, server mods only (manifest `api = "0.3"`,
/// experimental): sounds and vanilla's level events (particles) that every
/// player near the block sees and hears, LAN guests included.
interface effects {
    /// Plays a sound event (`minecraft:block.anvil.use`, or one a mod's pack
    /// adds) at a block's position, after the call; volume and pitch are
    /// clamped to 0 to 4 and 0.5 to 2. At most 64 effects a call.
    play-sound: func(dimension: string, x: s32, y: s32, z: s32, event: string, volume: f32, pitch: f32) -> result<_, string>;
    /// Vanilla's `levelEvent` at a block: 2000 smoke (data 0 to 8, the
    /// direction), 2004 spawner flames, 2005 bone meal particles (data
    /// 0 to 15, how many) and 2009 water evaporating. Others are refused.
    level-event: func(dimension: string, x: s32, y: s32, z: s32, id: s32, data: s32) -> result<_, string>;
}

/// What the server calls in a server mod when a block next to one of its
/// blocks changes (capability `block-entities`). The blocks asked about are
/// those where the mod keeps data (`block-entities.set`).
interface neighbor-events {
    /// The block at (from-x, from-y, from-z) became `from-state`; the mod's
    /// block next to it, at (x, y, z) in `state`, is told, in the tick the
    /// change was noticed (the start of the next server tick). At most 1024
    /// calls a tick; the rest are dropped.
    neighbor-changed: func(dimension: string, x: s32, y: s32, z: s32, state: string, from-x: s32, from-y: s32, from-z: s32, from-state: string);
}

/// The files a mod carries in its own package (`data/` and `assets/`), read
/// only: every mod has them, with no capability. A server mod keeps its own
/// recipe types there as JSON, a machine reads them at its start.
interface files {
    /// A file of the mod's package by its path in it (`data/mymod/press.json`),
    /// at most 1 MiB; none where there is no such file. Only `data/` and
    /// `assets/` are readable.
    read: func(path: string) -> option<list<u8>>;
    /// The paths in the package that start with `prefix` (`data/mymod/recipes/`),
    /// in order, at most 1024.
    paths: func(prefix: string) -> list<string>;
}

/// Data a server mod attaches to a player, a dimension or a chunk, saved
/// with the world beside its block data (as NeoForge's data attachments):
/// a player's mana, a dimension's weather machine, a chunk's pollution.
/// Every server mod has it, with no capability; each mod sees only its own.
interface attachments {
    record chunk {
        dimension: string,
        /// Chunk coordinates: a block's x and z shifted right by 4.
        x: s32,
        z: s32,
    }
    variant target {
        /// A player, by UUID, whether online or not.
        player(string),
        /// A dimension, `minecraft:overworld`.
        dimension(string),
        chunk(chunk),
    }
    /// The bytes under `key` (at most 64 characters) on `target`.
    get: func(target: target, key: string) -> option<list<u8>>;
    /// Keeps `data` (at most 64 KiB) under `key` on `target`; at most 65536
    /// values a mod.
    set: func(target: target, key: string, data: list<u8>) -> result<_, string>;
    /// Forgets the value under `key` on `target`.
    remove: func(target: target, key: string);
    /// The keys the mod keeps on `target`.
    keys: func(target: target) -> list<string>;
}

/// Capability `transfer`, server mods only (experimental): moving items,
/// fluids and energy between blocks, as NeoForge's capabilities
/// (`IItemHandler`, `IFluidHandler`, `IEnergyStorage`) do between mods.
/// Items go in and out of any inventory there is: chests, barrels, shulker
/// boxes, hoppers, dispensers, droppers, mod containers, and furnaces by
/// face as a hopper reaches them. Fluid tanks and batteries are the mods'
/// own: a mod puts one on its block and every mod fills and drains it.
/// What is moved is moved at once, during the call; `simulate` only asks.
interface transfer {
    record item-stack {
        item: string,
        count: u32,
    }
    /// The face of the block reached through, as a hopper or pipe touches
    /// it; none for the block as a whole.
    enum face {
        down,
        up,
        north,
        south,
        west,
        east,
    }
    /// The slots reachable through `face` of the inventory at a position in
    /// the simulated dimension; none where there is none.
    item-slots: func(dimension: string, x: s32, y: s32, z: s32, face: option<face>) -> option<list<option<item-stack>>>;
    /// Puts a stack in (merged with like stacks first, then into empty
    /// slots): how many did not fit.
    insert-item: func(dimension: string, x: s32, y: s32, z: s32, face: option<face>, stack: item-stack, simulate: bool) -> u32;
    /// Takes up to `count` of the first stack reachable: what was taken.
    extract-item: func(dimension: string, x: s32, y: s32, z: s32, face: option<face>, count: u32, simulate: bool) -> option<item-stack>;

    record fluid-stack {
        /// `minecraft:water`, `minecraft:lava` or a mod's own fluid id.
        fluid: string,
        /// In millibuckets: 1000 is a bucket.
        amount: u32,
    }
    record tank {
        content: option<fluid-stack>,
        capacity: u32,
    }
    /// Gives one of the mod's own blocks a tank of `capacity` millibuckets
    /// (keeping what it holds when it had one). Saved with the world.
    add-tank: func(dimension: string, x: s32, y: s32, z: s32, capacity: u32) -> result<_, string>;
    /// The tank on a block: what it holds and how much it can.
    get-tank: func(dimension: string, x: s32, y: s32, z: s32) -> option<tank>;
    /// Pours in (one fluid a tank): how much went in.
    fill: func(dimension: string, x: s32, y: s32, z: s32, stack: fluid-stack, simulate: bool) -> u32;
    /// Takes out up to `amount`: what came out.
    drain: func(dimension: string, x: s32, y: s32, z: s32, amount: u32, simulate: bool) -> option<fluid-stack>;

    record battery {
        stored: u64,
        capacity: u64,
    }
    /// Gives one of the mod's own blocks a battery of `capacity` units (any
    /// unit the mods agree on, as Forge Energy). Saved with the world.
    add-battery: func(dimension: string, x: s32, y: s32, z: s32, capacity: u64) -> result<_, string>;
    /// The battery on a block: what it stores and how much it can.
    get-battery: func(dimension: string, x: s32, y: s32, z: s32) -> option<battery>;
    /// Charges: how much it took.
    receive-energy: func(dimension: string, x: s32, y: s32, z: s32, amount: u64, simulate: bool) -> u64;
    /// Discharges: how much came out.
    extract-energy: func(dimension: string, x: s32, y: s32, z: s32, amount: u64, simulate: bool) -> u64;
    /// Takes the tank and battery off one of the mod's own blocks.
    remove-storage: func(dimension: string, x: s32, y: s32, z: s32);
}

/// What the server calls in a server mod when a player uses an item
/// (capability `block-entities`, as `block-used`).
interface item-events {
    /// The block a player clicked with the item.
    record block-target {
        dimension: string,
        x: s32,
        y: s32,
        z: s32,
        /// The face clicked: 0 down, 1 up, 2 north, 3 south, 4 west, 5 east.
        face: u8,
        /// `mymod:gear[axis=y]`.
        state: string,
    }
    /// A player right-clicked with `item` in the main hand, on a block or in
    /// the air, sneaking or not, before anything vanilla does with it:
    /// offered to every server mod, those whose namespace the item or the
    /// block is in first, until one takes it:
    /// true takes the click (a wrench turning a block, a filter set on a
    /// machine), and nothing else happens.
    item-used: func(player: string, item: string, sneaking: bool, target: option<block-target>) -> bool;
}

/// Messages between server mods: one mod's API for others (an addon asking
/// a tech mod for a machine's speed, a mod telling another its block
/// changed). Every server mod has it, with no capability.
interface peers {
    /// Sends `data` (at most 64 KiB) to the running server mod with this
    /// id; it hears it as `peer-events.message` at the start of the next
    /// server tick. At most 64 messages a call.
    send: func(mod: string, data: list<u8>) -> result<_, string>;
    /// Whether a server mod with this id runs now.
    running: func(mod: string) -> bool;
}

/// What the server calls in a server mod a peer wrote to.
interface peer-events {
    /// A message from the server mod `from` (its id).
    message: func(%from: string, data: list<u8>);
}

/// Capability `menus`, server mods only (experimental): a container of the
/// mod's own (`containers.register`) opened with a screen of its own, as
/// NeoForge's menus and screens are: where each slot is drawn, labels,
/// progress bars fed by the menu's data values (`ContainerData`) and buttons
/// the mod hears (`clickMenuButton`). Horizon's clients draw it; a vanilla
/// client sees the container as a chest. Positions are in GUI pixels from
/// the screen's top left corner, as a container screen's are.
interface menus {
    /// A slot of the menu and where it is drawn: slots 0 up to the
    /// container's size are the container's, then 27 of the player's main
    /// inventory and 9 of the hotbar.
    record slot-pos {
        slot: u32,
        x: s32,
        y: s32,
    }
    record label {
        x: s32,
        y: s32,
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    /// A bar filled as data value `value` is to data value `max` (a
    /// furnace's arrow, a machine's progress, a tank's level).
    record progress {
        x: s32,
        y: s32,
        width: u32,
        height: u32,
        value: u32,
        max: u32,
        /// Fills upward instead of rightward.
        vertical: bool,
        /// 0xRRGGBB of the filled part and of the rest.
        color: u32,
        background: u32,
    }
    record button {
        /// What `menu-events.button` hears.
        id: u32,
        x: s32,
        y: s32,
        width: u32,
        height: u32,
        label: string,
    }
    /// A box the player types into: what they typed reaches
    /// `menu-events.text` when they press Enter and when the screen closes.
    record text-field {
        id: u32,
        x: s32,
        y: s32,
        width: u32,
        /// What it holds when the screen opens.
        value: string,
        /// At most 256.
        max-length: u32,
    }
    variant widget {
        label(label),
        progress(progress),
        button(button),
        text-field(text-field),
    }
    record layout {
        /// The screen's size, at most 512 x 512.
        width: u32,
        height: u32,
        /// Where the menu's slots are drawn (at most 72); a slot left out
        /// is not drawn and cannot be clicked.
        slots: list<slot-pos>,
        /// At most 64.
        widgets: list<widget>,
    }
    /// Opens the container at a position (one of the mod's registered
    /// containers) for a player, after the call, with this screen. False
    /// when the player is not online or the layout is too large.
    open: func(player: string, dimension: string, x: s32, y: s32, z: s32, layout: layout) -> bool;
    /// Sets data value `index` (0 to 31) of the screen the player has open
    /// from this mod, sent to their client; the bars read it.
    set-data: func(player: string, index: u32, value: s32) -> bool;
    /// Opens a screen of the mod's own with no block behind it (a toolbox,
    /// a book, a schedule), after the call: the layout's widgets on a panel
    /// over the dimmed world; its slots are not drawn. Esc closes it
    /// (`menu-events.closed`). False when the player is not online.
    open-panel: func(player: string, layout: layout) -> bool;
    /// Closes the screen the mod opened for a player, after the call.
    close: func(player: string);
}

/// What the server calls in a server mod about its screens.
interface menu-events {
    /// The player pressed button `id` on the mod's screen they have open.
    button: func(player: string, id: u32);
    /// What the player typed into text field `id` (on Enter, and for every
    /// field as the screen closes).
    text: func(player: string, id: u32, value: string);
    /// The player closed the mod's screen (Esc, or leaving its container).
    closed: func(player: string);
}

/// Capability `console`, server mods only (experimental): any command run
/// as the server's console, with an operator's rights, after the call, as
/// a command block or a datapack function would: giving and clearing items,
/// effects, experience, teleports, summons. Players see no feedback; the
/// server's log has a line per batch. The SDK's `player_ops` builds the usual
/// ones.
interface console {
    /// Runs `line` (no leading slash needed) at the end of this tick. At most
    /// 256 commands a call; a line that does not parse fails then, not now.
    run: func(line: string) -> result<_, string>;
}

/// Capability `stacks`, server mods only (experimental): what an item
/// stack carries beyond its item and count, as NeoForge's data components:
/// damage, a custom name, enchantments, and the mod's own bytes, kept in
/// vanilla's `minecraft:custom_data` under `horizon:<mod id>` so they stay
/// with the stack wherever it goes (a filter's setting, a tool's charge).
/// Each mod sees and writes only its own bytes.
interface stacks {
    record stack {
        item: string,
        count: u32,
        /// Durability used up.
        damage: u32,
        /// `minecraft:custom_name` as plain text.
        name: option<string>,
        /// `minecraft:fortune`, 3.
        enchantments: list<tuple<string, u32>>,
        /// The mod's own bytes on it, at most 16 KiB.
        data: option<list<u8>>,
    }
    /// A slot of a player's inventory (0 to 40, as `players.inventory`) as of
    /// the start of this tick.
    player-stack: func(player: string, slot: u32) -> option<stack>;
    /// Puts a stack in a player's slot (none empties it), after the call.
    /// What other mods keep on the stack there stays when the item does.
    set-player-stack: func(player: string, slot: u32, stack: option<stack>) -> bool;
    /// A slot of an inventory (a chest, a mod container, a furnace) in the
    /// simulated dimension, as it is now.
    container-stack: func(dimension: string, x: s32, y: s32, z: s32, slot: u32) -> option<stack>;
    /// Puts a stack in an inventory's slot at once (none empties it); false
    /// when there is no such slot.
    set-container-stack: func(dimension: string, x: s32, y: s32, z: s32, slot: u32, stack: option<stack>) -> bool;
}

/// The game's recipes, as vanilla's data and content mods' `data/` give
/// them (NeoForge's `RecipeManager`): a machine of a mod's crafts, cooks or
/// cuts as vanilla's stations do (a fan smelting what blows past it, a
/// crafter of the mod's), and recipe types of the mod's own are read from
/// every content mod's `data/<namespace>/recipe/` files, so other mods add
/// recipes to its machines as data. Every server mod has it, with no
/// capability.
interface recipe-manager {
    /// An item and how many of it.
    record item-count {
        item: string,
        count: u32,
    }
    /// A crafting recipe a grid matched.
    record crafted {
        /// The recipe's id, `minecraft:oak_planks`.
        recipe: string,
        output: item-count,
        /// What stays in each cell of the grid once it is crafted (a bucket
        /// from a milk bucket), row by row as the grid.
        remainders: list<option<item-count>>,
    }
    /// A cooking recipe.
    record cooked {
        recipe: string,
        output: item-count,
        experience: f32,
        /// Ticks it takes.
        time: u32,
    }
    /// A recipe file of a type the game does not run itself.
    record recipe-file {
        /// `gears:pressing/iron`: the namespace, then the path under
        /// `recipe/` without `.json`.
        id: string,
        /// The file's JSON as written.
        json: string,
    }
    /// The crafting table's recipe for a `width` by `width` grid (1 to 3,
    /// cells row by row), matched as vanilla matches it (a shaped recipe
    /// anywhere in the grid, mirrored too).
    craft: func(grid: list<option<item-count>>, width: u32) -> option<crafted>;
    /// The cooking recipe of `kind` (`minecraft:smelting`,
    /// `minecraft:blasting`, `minecraft:smoking` or
    /// `minecraft:campfire_cooking`) taking `item`.
    cook: func(kind: string, item: string) -> option<cooked>;
    /// The stonecutter's recipes taking `item`, in its order: each recipe's
    /// id and result.
    stonecut: func(item: string) -> list<tuple<string, item-count>>;
    /// Every recipe file of type `kind` (`gears:pressing`) the content mods
    /// carry, by id; empty for vanilla's own types (`minecraft:`).
    of-type: func(kind: string) -> list<recipe-file>;
    /// Whether an ingredient, as recipe files write one (`minecraft:iron_ingot`,
    /// `#minecraft:logs`, or a JSON list of them), takes `item`.
    test-ingredient: func(ingredient: string, item: string) -> bool;
}

/// One of a server mod's entities of its own types (`entity-types`), as
/// its events and reads give it. Types only: every server mod has it.
interface entity-data {
    /// One of the mod's entities, as of the start of this tick.
    record entity {
        /// The game's id for it, the same after a restart.
        id: u32,
        /// Its type, `mymod:roller`.
        kind: string,
        dimension: string,
        /// Its bottom centre.
        x: f64,
        y: f64,
        z: f64,
        yaw: f32,
        /// Blocks a tick.
        vx: f64,
        vy: f64,
        vz: f64,
        on-ground: bool,
        health: f32,
        /// The mod's own bytes on it (`set-data`).
        data: list<u8>,
    }
}

/// Capability `entities`, server mods only (experimental): entity types
/// of the mod's own, as NeoForge's `EntityType`s. The game keeps each one:
/// it falls and slides as the type says, takes hits, and is saved with the
/// world with the mod's own bytes; the mod gives it its behaviour each tick
/// (`entity-events`). Every client sees it as an invisible armor stand
/// wearing the type's model on its head (a block's item is drawn as the
/// block), with the armor stand's hitbox.
interface entity-types {
    use entity-data.{entity};
    record entity-type {
        /// `mymod:roller`, in one of the mod's namespaces.
        id: string,
        /// The item its model is, worn on its head: `mymod:roller`.
        model: string,
        /// The small armor stand's size (0.5 by 0.9875) instead of the full
        /// one (0.5 by 1.975).
        small: bool,
        /// Falls as a mob does (0.08 a tick); false: it floats and moves only
        /// by its velocity.
        gravity: bool,
        /// The health it starts with, at most 1024; 0: no hit hurts it.
        health: f32,
    }
    /// Registers a type, at init or later; again replaces it for entities
    /// spawned from then on. At most 64 types.
    register: func(def: entity-type) -> result<_, string>;
    /// Spawns an entity of a registered type, after the call; its id now.
    /// At most 256 of the mod's at once.
    spawn: func(kind: string, dimension: string, x: f64, y: f64, z: f64, yaw: f32) -> result<u32, string>;
    /// One of the mod's entities as of this tick's start; none for one
    /// spawned this tick or gone.
    get: func(id: u32) -> option<entity>;
    /// Every entity of the mod's, as of this tick's start.
    all: func() -> list<entity>;
    /// Sets its velocity, blocks a tick (each at most 10), after the call. On
    /// the ground it slows as a mob does (0.546 a tick), in the air by 0.91.
    set-velocity: func(id: u32, vx: f64, vy: f64, vz: f64) -> bool;
    /// Puts it at a position, facing `yaw`, after the call.
    move-to: func(id: u32, x: f64, y: f64, z: f64, yaw: f32) -> bool;
    /// Keeps bytes on it (at most 4 KiB), saved with it.
    set-data: func(id: u32, data: list<u8>) -> bool;
    /// Takes `amount` off its health, after the call; at 0 it dies
    /// (`entity-events.died`).
    hurt: func(id: u32, amount: f32) -> bool;
    /// Changes the item its model is.
    set-model: func(id: u32, item: string) -> bool;
    /// Turns a part of its model, as `entities.set-pose` does: `head` turns
    /// the model.
    set-pose: func(id: u32, part: string, x: f32, y: f32, z: f32) -> bool;
    /// Removes it, after the call, with no `died`.
    remove: func(id: u32) -> bool;
}

/// What the server calls in a server mod for its entity types.
interface entity-events {
    use entity-data.{entity};
    /// Each server tick, the mod's entities in the dimension the server
    /// simulates, after the game moved them: their behaviour.
    tick: func(entities: list<entity>);
    /// A player hit one with `damage` (their attack's). True takes the hit
    /// (no damage); false lets the game take it off its health.
    attacked: func(id: u32, player: string, damage: f32) -> bool;
    /// A player right-clicked one, `item` in their main hand ("" for none).
    interacted: func(id: u32, player: string, item: string);
    /// Its health reached 0; it is gone after the call.
    died: func(id: u32, kind: string);
}

/// A client mod: runs in the player's game.
world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import storage;
    import command;
    export events;
}

/// A server mod (manifest `side = "server"`, `api = "0.3"`, experimental):
/// runs where the world is simulated, on the dedicated server, a LAN host
/// and single player's own server.
world horizon-server-mod {
    import log;
    import storage;
    import players;
    import %world;
    export server-events;
}

/// A server mod with blocks (capability `block-entities`): the SDK builds
/// every server mod against this world. Mods built for `horizon-server-mod`
/// alone (no `block-events` export) still load and hear nothing of blocks.
world horizon-block-mod {
    include horizon-server-mod;
    import block-entities;
    import visuals;
    import structures;
    export block-events;
    import net;
    export server-net-events;
    import entities;
    import containers;
    import redstone;
    import items;
    import effects;
    export neighbor-events;
    import files;
    import attachments;
    import transfer;
    export item-events;
    import peers;
    export peer-events;
    import menus;
    export menu-events;
    import console;
    import stacks;
    import recipe-manager;
    import entity-types;
    export entity-events;
}

/// The game's side of `entity-types` and `entity-events`.
world entity-types-host {
    import entity-types;
    export entity-events;
}

/// The game's side of `recipe-manager` (imports only).
world recipe-manager-host {
    import recipe-manager;
}

/// The game's side of capability `stacks` (imports only).
world stacks-host {
    import stacks;
}

/// The game's side of capability `console` (imports only).
world console-host {
    import console;
}

/// The game's side of capability `menus`.
world menus-host {
    import menus;
    export menu-events;
}

/// The game's side of `peers` and `peer-events`.
world peers-host {
    import peers;
    export peer-events;
}

/// The game's side of `item-events`.
world item-host {
    export item-events;
}

/// The game's side of capability `transfer` (imports only).
world transfer-host {
    import transfer;
}

/// The game's side of `attachments` (imports only).
world attachments-host {
    import attachments;
}

/// The game's side of `files` (imports only).
world files-host {
    import files;
}

/// The game's side of `neighbor-events`.
world neighbor-host {
    export neighbor-events;
}

/// The game's side of capability `effects` (imports only).
world effects-host {
    import effects;
}

/// The game's side of capability `items` (imports only).
world items-host {
    import items;
}

/// The game's side of capability `redstone` (imports only).
world redstone-host {
    import redstone;
}

/// The game's side of `horizon-block-mod` beyond `horizon-server-mod`.
world block-host {
    import block-entities;
    export block-events;
}

/// The game's side of `visuals` (imports only).
world visuals-host {
    import visuals;
}

/// The game's side of `structures` (imports only).
world structures-host {
    import structures;
}

/// The game's side of capability `net` for client mods (it adds the `net`
/// import for server mods too).
world net-host {
    import net;
    export net-events;
}

/// The game's side of capability `containers` (imports only).
world containers-host {
    import containers;
}

/// The game's side of capability `entities` (imports only).
world entities-host {
    import entities;
}

/// The game's side of `server-net-events`.
world server-net-host {
    export server-net-events;
}

/// A mod with widgets (capability `ui`): the SDK builds every mod against
/// this world. Mods built for `horizon-mod` alone (no `ui-events` export)
/// still load and simply hear nothing of their widgets.
world horizon-ui-mod {
    include horizon-mod;
    import ui;
    import render;
    import input;
    import recipes;
    import browser;
    export ui-events;
    import net;
    export net-events;
    import block-data;
}

/// The game's side of `block-data` (imports only).
world block-data-host {
    import block-data;
}

/// The game's side of `horizon-ui-mod` beyond `horizon-mod`.
world ui-host {
    import ui;
    export ui-events;
}

/// The game's side of capability `render` (imports only).
world render-host {
    import render;
    import input;
}

/// The game's side of capability `recipes` (imports only).
world recipes-host {
    import recipes;
    import browser;
}
